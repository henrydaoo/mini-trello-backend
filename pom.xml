<!--
                Spotless: auto-formats + checks Java code style using Google Java Format.
                - `mvn spotless:apply`  -> auto-format all files in place
                - `mvn spotless:check`  -> fails the build if any file is not formatted
                Bound to `validate` (the very first lifecycle phase) instead of `verify`:
                formatting is a cheap, compile-free check, so it should fail fast —
                before wasting time on compile/test/package if the code isn't formatted.
            -->
<plugin>
    <groupId>com.diffplug.spotless</groupId>
    <artifactId>spotless-maven-plugin</artifactId>
    <version>${spotless.version}</version>
    <configuration>
        <java>
            <googleJavaFormat>
                <version>1.19.2</version>
                <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
        </java>
    </configuration>
    <executions>
        <execution>
            <phase>validate</phase>
            <goals>
                <goal>check</goal>
            </goals>
        </execution>
    </executions>
</plugin>